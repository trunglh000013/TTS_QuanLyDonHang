{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost,1433;Database=ProductTestDb;User Id=sa;Password=sa;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Enrichers.Environment",
      "Serilog.Enrichers.Thread"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss,fff} {ThreadId} {Level:u4} [{TraceId}] {Message} - {SourceContext}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/product-test.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss,fff} {ThreadId} {Level:u4} [{TraceId}] {Message} - {SourceContext}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ],
    "Properties": {
      "Application": "ProductTest"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Secret": "ProductTestSecretKey12312321adsad!@",
    "Issuer": "ProductTest-API",
    "Audience": "ProductTest-Users",
    "TokenExpireMinutes": 60,
    "RefreshTokenExpireDays": 7
  },
  "RequestLogging": {
    "RequestStartedTemplate": "Request started {RequestMethod} {RequestPath}{QueryString} from {RemoteIp} with culture {Culture}",
    "RequestCompletedTemplate": "Request completed {RequestMethod} {RequestPath} with status code {StatusCode} in {ElapsedMilliseconds:0.0000} ms",
    "RequestErrorTemplate": "Unhandled exception for request {RequestMethod} {RequestPath}{QueryString} after {ElapsedMilliseconds:0.0000} ms"
  },
  "Template": {
    "Product": {
      "FilePath": "Template\\Product\\ProductTemplate.xlsx"
    }
  }
}